<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE). Only what the
  INFOPLIST_KEY_ build settings can't express lives here: the .pbn type.

  Neither platform has a system type for .pbn, which is why Safari greys PBN
  files out of a file picker. Exporting one -- conforming to plain text,
  matched on the extension -- makes them pickable here and puts this app in
  the share sheet and under "Open in" for them. PBN is an open specification
  with no owner, so this is as much ours to declare as anyone's.

  Other bridge apps export their own type for .pbn (Shark Bridge Game's is
  com.emabridge.bridgedeal), and which export the system honours is
  undocumented. So the second document type claims the extension itself,
  keeping this app under "Open With" whoever wins, and the file picker takes
  every type .pbn maps to (UTType.pbnFiles).

  The document icon is drawn by the system (macOS 11 and later): a page
  badged with the app icon and labelled PBN. Finder shows it only where this
  export is the one honoured; otherwise the winning app's icon shows.

  Keep the identifier in step with UTType.pbn in PBNFile.swift.

  LIN (Bridge Base Online's hand records) gets the same pair, a type of our
  own matched on .lin and a claim on the extension. BBO declares no type for
  it. The app owns LIN (LSHandlerRank Owner): it reads it into PBN the way
  Bridge Composer opens it, and is offered first for it. Keep the identifier
  in step with UTType.lin.
-->
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.popperbiz.pbn</string>
			<key>UTTypeDescription</key>
			<string>Portable Bridge Notation</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconBadgeName</key>
				<string>AppIcon</string>
				<key>UTTypeIconText</key>
				<string>PBN</string>
			</dict>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pbn</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.popperbiz.lin</string>
			<key>UTTypeDescription</key>
			<string>Bridge Base Online hand record</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeIcons</key>
			<dict>
				<key>UTTypeIconBadgeName</key>
				<string>AppIcon</string>
				<key>UTTypeIconText</key>
				<string>LIN</string>
			</dict>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>lin</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Portable Bridge Notation</string>
			<key>CFBundleTypeIconSystemGenerated</key>
			<true/>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.popperbiz.pbn</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Portable Bridge Notation</string>
			<key>CFBundleTypeIconSystemGenerated</key>
			<true/>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Default</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>pbn</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Bridge Base Online hand record</string>
			<key>CFBundleTypeIconSystemGenerated</key>
			<true/>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.popperbiz.lin</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Bridge Base Online hand record</string>
			<key>CFBundleTypeIconSystemGenerated</key>
			<true/>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>lin</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
